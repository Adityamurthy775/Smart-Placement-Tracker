# ── Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# ── Only `VITE_`-prefixed keys reach the browser, and Vite INLINES them into the
# ── built bundle. Anything secret must never use this prefix.

# Backend API base URL. Exactly ONE value — this is interpolated as
# `${API_BASE}/user-api/...` at 23 call sites, so a comma-separated list here
# produces a malformed host ("...onrender.com,http") and every request fails.
# For local development prefer `.env.local` (already gitignored via `*.local`):
#   VITE_API_BASE_URL=http://localhost:5000
VITE_API_BASE_URL=https://your-backend.onrender.com

# Google Sign-In client ID. Public by design — it ships in the bundle.
# Must match GOOGLE_CLIENT_ID in backend/.env exactly.
VITE_GOOGLE_CLIENT_ID=

# External resume/ATS checker opened from the dashboard.
VITE_ATS_CHECKER_URL=

# EmailJS (candidate status emails sent from the dashboard).
# All three are public keys; the *private* key stays in EmailJS, not here.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
