# ── Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# ── Every key here is read via `process.env` on the backend (no VITE_ prefix).

# --- Server ---
PORT=5000
# Comma-separated list of origins allowed through CORS. The deployed frontend
# plus local Vite. server.js reads this as a single value; add more origins by
# appending to the list. Localhost ports 5173-5180 are always allowed.
FRONTEND_URL=https://your-frontend.vercel.app
# Set to "true" when the backend is behind a TLS-terminating proxy and you want
# the auth cookie forced Secure. Leave unset for plain-HTTP local dev — a
# `Secure` cookie is rejected by the browser on http://localhost, which makes
# login fail with an opaque "Network Error". Normally unnecessary: the server
# detects HTTPS from `x-forwarded-proto` on its own.
# COOKIE_SECURE=false

# --- Database ---
# MongoDB Atlas connection string. The password is part of this URL.
DB_URL=mongodb+srv://USER:PASSWORD@cluster0.XXXX.mongodb.net/college?appName=Cluster0

# --- Auth ---
# Signs and verifies JWTs. MUST be replaced with a long random string: anything
# short or guessable lets anyone mint a valid token for any user.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env exactly.
GOOGLE_CLIENT_ID=
# Server-side only. NEVER put this in a VITE_ variable — those are inlined into
# the client bundle and are public the moment the site is built.
GOOGLE_CLIENT_SECRET=

# --- Cloudinary (image uploads) ---
CLOUD_NAME=
CLOUD_API_KEY=
# Note the spelling: the code reads `CLOUD_API_SCREET_KEY` (sic) in
# backend/cofig/cloudinary.js. Rename both together if you ever fix the typo.
CLOUD_API_SCREET_KEY=

# --- Email (nodemailer / Gmail) ---
# EMAIL_PASS must be a 16-character Google App Password, not your account
# password. https://myaccount.google.com/apppasswords
EMAIL_USER=your.address@gmail.com
EMAIL_PASS=
